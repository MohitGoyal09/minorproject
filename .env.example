# Copy to .env (or set these in the host dashboard). Never commit real secrets.

# Signing key for JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me-before-deploying

# Seeded accountant account, created on the first login when no users exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Token lifetime in minutes (default 8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite by default; set Postgres in production.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname?sslmode=require
